{
  "name": "@graphistry/client-api-context",
  "version": "5.1.6",
  "description": "React provider + hooks over @graphistry/client-api",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf dist node_modules",
    "lint": "echo 'lint not configured yet'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphistry/graphistry-js.git"
  },
  "homepage": "https://github.com/graphistry/graphistry-js/projects/client-api-context#readme",
  "author": "Graphistry, Inc <https://graphistry.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@graphistry/client-api": "^5.1.6"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
